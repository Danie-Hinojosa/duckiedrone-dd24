<?xml version="1.0"?>
<!--
  Duckiedrone DD24-B.
  Meshes: Duckietown (dt-duckiebot-interface/packages/STL), in millimeters (scale 0.001).
  ROS axes: x forward (where the camera is), y left, z up. base_link = top face
  of the bottom plate.

  Measured from the meshes: each motor sits at the center of a prop guard ring, at (±0.091, ±0.091) m
  (rings with 65 mm inner radius; props ~63 mm radius).
  Taken from photos of the drone: motors on the bottom plate, props between the two ring
  levels, cylindrical legs under each motor, Raspberry Pi and HAT on the top plate,
  battery strapped underneath, camera at the front.
  Measured: mass 1.76 kg with battery; overall size 315 x 283 x 116 mm (spec).
  Note: the Duckietown plates are 332 x 332 mm; this difference still needs checking on the drone.
  Estimated: inertia and exact heights of the electronics.
  Measured on the drone: plates 35 mm apart; legs 47 mm (bottom plate to floor).

  Motors (PX4 numbering and spin direction):
    1 front-right   CCW   2 rear-left   CCW
    3 front-left    CW    4 rear-right  CW
-->
<robot name="duckiedrone_dd24">

  <material name="carbon"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="motor"><color rgba="0.75 0.15 0.10 1"/></material>
  <material name="prop"><color rgba="1.0 0.92 0.0 0.9"/></material>
  <material name="board"><color rgba="0.10 0.45 0.20 1"/></material>
  <material name="hat"><color rgba="1.0 0.65 0.1 1"/></material>
  <material name="battery"><color rgba="0.15 0.25 0.6 1"/></material>
  <material name="sensor"><color rgba="0.1 0.5 0.9 1"/></material>

  <!-- ===================== body ===================== -->
  <link name="base_link">
    <!-- bottom plate (with the lower rings and the motor mounts) -->
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_BottomPlate_GPIO_X_STL.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="carbon"/>
    </visual>
    <!-- top plate (upper rings), above the props -->
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_TopPlate_GPIO_X_STL.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="carbon"/>
    </visual>
    <!-- Raspberry Pi on the top plate, with the HAT and breadboard on top -->
    <visual>
      <origin xyz="0.005 0 0.046"/>
      <geometry><box size="0.085 0.056 0.017"/></geometry>
      <material name="board"/>
    </visual>
    <visual>
      <origin xyz="0.012 0 0.0595"/>
      <geometry><box size="0.065 0.050 0.010"/></geometry>
      <material name="hat"/>
    </visual>
    <!-- flight controller and ESC between the plates -->
    <visual>
      <origin xyz="0 0 0.012"/>
      <geometry><box size="0.040 0.040 0.016"/></geometry>
      <material name="black"/>
    </visual>
    <!-- battery holder and 4S battery hanging underneath -->
    <visual>
      <origin xyz="-0.043 -0.0175 -0.003"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Proto_Battery_Support_4S_3Dprint_STL.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <!-- shifted back: on the real drone the ToF sees the floor, not the battery -->
      <origin xyz="-0.05 0 -0.022"/>
      <geometry><box size="0.075 0.035 0.034"/></geometry>
      <material name="battery"/>
    </visual>
    <!-- bottom ToF mount -->
    <visual>
      <origin xyz="-0.070 -0.0255 -0.003"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_ToF_Support_STL.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.007"/>
      <geometry><box size="0.33 0.33 0.085"/></geometry>
    </collision>
  </link>

  <!-- KDL does not accept inertia on the root link, so the body mass goes in a separate fixed link -->
  <link name="body_inertia">
    <inertial>
      <!-- 1.76 kg weighed with battery; inertia of a 315 x 283 x 116 mm box at 60 %
           (mass is concentrated in the center: Pi, battery, FC) -->
      <origin xyz="0 0 0.010"/>
      <mass value="1.76"/>
      <inertia ixx="0.0082" ixy="0" ixz="0" iyy="0.0099" iyz="0" izz="0.0158"/>
    </inertial>
  </link>
  <joint name="body_inertia_joint" type="fixed">
    <parent link="base_link"/><child link="body_inertia"/>
  </joint>

  <!-- ===================== legs: one cylinder under each motor ===================== -->
  <!-- the mesh is 43 mm; scaled to the 47 mm measured on the drone -->
  <link name="landing_gear_link">
    <visual>
      <origin xyz="0.091 -0.091 -0.0025" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Landing_Gear_STL.stl" scale="0.001 0.001093 0.001"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.091 0.091 -0.0025" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Landing_Gear_STL.stl" scale="0.001 0.001093 0.001"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.091 0.091 -0.0025" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Landing_Gear_STL.stl" scale="0.001 0.001093 0.001"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.091 -0.091 -0.0025" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Landing_Gear_STL.stl" scale="0.001 0.001093 0.001"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="landing_gear_joint" type="fixed">
    <parent link="base_link"/><child link="landing_gear_link"/>
  </joint>

  <!-- ===================== motors and props ===================== -->
  <!-- each rotor origin is 3 mm above the bottom plate, which puts the mesh blades
       (18.5-27.7 mm above their origin) 4 mm below the top plate -->
  <!-- motor 1: front-right, CCW -->
  <link name="rotor_1">
    <visual><origin xyz="0 0 0.006"/><geometry><cylinder radius="0.0135" length="0.018"/></geometry><material name="motor"/></visual>
    <visual><geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_CCW_prop_STL.stl" scale="0.001 0.001 0.001"/></geometry><material name="prop"/></visual>
  </link>
  <joint name="rotor_1_joint" type="continuous">
    <parent link="base_link"/><child link="rotor_1"/>
    <origin xyz="0.091 -0.091 0.003"/><axis xyz="0 0 1"/>
  </joint>

  <!-- motor 2: rear-left, CCW -->
  <link name="rotor_2">
    <visual><origin xyz="0 0 0.006"/><geometry><cylinder radius="0.0135" length="0.018"/></geometry><material name="motor"/></visual>
    <visual><geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_CCW_prop_STL.stl" scale="0.001 0.001 0.001"/></geometry><material name="prop"/></visual>
  </link>
  <joint name="rotor_2_joint" type="continuous">
    <parent link="base_link"/><child link="rotor_2"/>
    <origin xyz="-0.091 0.091 0.003"/><axis xyz="0 0 1"/>
  </joint>

  <!-- motor 3: front-left, CW -->
  <link name="rotor_3">
    <visual><origin xyz="0 0 0.006"/><geometry><cylinder radius="0.0135" length="0.018"/></geometry><material name="motor"/></visual>
    <visual><geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_CW_prop_STL.stl" scale="0.001 0.001 0.001"/></geometry><material name="prop"/></visual>
  </link>
  <joint name="rotor_3_joint" type="continuous">
    <parent link="base_link"/><child link="rotor_3"/>
    <origin xyz="0.091 0.091 0.003"/><axis xyz="0 0 1"/>
  </joint>

  <!-- motor 4: rear-right, CW -->
  <link name="rotor_4">
    <visual><origin xyz="0 0 0.006"/><geometry><cylinder radius="0.0135" length="0.018"/></geometry><material name="motor"/></visual>
    <visual><geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_CW_prop_STL.stl" scale="0.001 0.001 0.001"/></geometry><material name="prop"/></visual>
  </link>
  <joint name="rotor_4_joint" type="continuous">
    <parent link="base_link"/><child link="rotor_4"/>
    <origin xyz="-0.091 -0.091 0.003"/><axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== sensors ===================== -->
  <!-- flight controller (IMU) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.012"/>
  </joint>

  <!-- bottom ToF: sensor_msgs/Range measures along +x, so x points down -->
  <link name="tof_bottom_link">
    <visual><origin xyz="-0.003 0 0"/><geometry><box size="0.006 0.012 0.012"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="tof_bottom_joint" type="fixed">
    <parent link="base_link"/><child link="tof_bottom_link"/>
    <origin xyz="0 0 -0.006" rpy="0 1.5708 0"/>
  </joint>

  <!-- Front camera mount (Duckietown mesh). It rests on the bottom plate with a 3 mm
       tab on the front edge (the plate ends at x = 0.112 m) and sticks out ~25 mm.
       In the mesh, front is -y and up is +z, so it is rotated 90° about z. -->
  <link name="camera_mount_link">
    <visual>
      <geometry><mesh filename="package://duckiedrone_dd24/meshes/DD24_Camera_mount_STL.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/><child link="camera_mount_link"/>
    <origin xyz="0.093 0.01795 0" rpy="0 0 1.5708"/>
  </joint>

  <!-- Camera (OV5647, 160° fisheye). The mount face that holds the board has normal
       (0.64, 0, -0.77) on the drone, so the optical axis points 50° below horizontal.
       camera_link follows the ROS convention: x along the optical axis. -->
  <link name="camera_link">
    <visual><origin xyz="-0.004 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.007" length="0.012"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.1277 0 0.0082" rpy="0 0.8779 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Front ToF (VL53L1X) at the bottom of the camera mount, facing forward.
       Only runs with the Duckietown extra_sensors stack. -->
  <link name="tof_front_link">
    <visual><origin xyz="-0.003 0 0"/><geometry><box size="0.006 0.012 0.012"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="tof_front_joint" type="fixed">
    <parent link="base_link"/><child link="tof_front_link"/>
    <origin xyz="0.1375 0 -0.008"/>
  </joint>

</robot>

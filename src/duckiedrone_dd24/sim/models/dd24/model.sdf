<?xml version="1.0" encoding="UTF-8"?>
<!--
  Duckiedrone DD24-B para PX4 SITL (Gazebo Harmonic).
  Misma geometría que urdf/dd24.urdf: motores en (±0.091, ±0.091) m, placas separadas 35 mm,
  patas de 47 mm, masa 1.76 kg (pesado con batería). Las constantes de los motores son estimadas:
  maxRotVelocity 2400 rad/s y motorConstant elegidos para hover cerca del 55 % de la velocidad máxima.
  Los nombres de los sensores (imu_sensor, air_pressure_sensor, navsat_sensor) son los que espera
  el gz_bridge de PX4. tof_bottom es un lidar de un rayo hacia abajo que hace de ToF.
-->
<sdf version="1.9">
  <model name="dd24">
    <pose>0 0 0.06 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <pose>0 0 0.010 0 0 0</pose>
        <mass>1.76</mass>
        <inertia><ixx>0.0082</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0099</iyy><iyz>0</iyz><izz>0.0158</izz></inertia>
      </inertial>
      <visual name="bottom_plate">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_BottomPlate_GPIO_X_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="top_plate">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_TopPlate_GPIO_X_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="raspberry_pi">
        <pose>0.005 0 0.046 0 0 0</pose>
        <geometry><box><size>0.085 0.056 0.017</size></box></geometry>
        <material><ambient>0.10 0.45 0.20 1</ambient><diffuse>0.10 0.45 0.20 1</diffuse></material>
      </visual>
      <visual name="hat">
        <pose>0.012 0 0.0595 0 0 0</pose>
        <geometry><box><size>0.065 0.050 0.010</size></box></geometry>
        <material><ambient>1.0 0.65 0.1 1</ambient><diffuse>1.0 0.65 0.1 1</diffuse></material>
      </visual>
      <visual name="battery">
        <pose>-0.05 0 -0.022 0 0 0</pose>
        <geometry><box><size>0.075 0.035 0.034</size></box></geometry>
        <material><ambient>0.15 0.25 0.6 1</ambient><diffuse>0.15 0.25 0.6 1</diffuse></material>
      </visual>
      <visual name="leg_0">
        <pose>0.091 -0.091 -0.0025 1.5708 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_Landing_Gear_STL.stl</uri><scale>0.001 0.001093 0.001</scale></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="leg_1">
        <pose>-0.091 0.091 -0.0025 1.5708 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_Landing_Gear_STL.stl</uri><scale>0.001 0.001093 0.001</scale></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="leg_2">
        <pose>0.091 0.091 -0.0025 1.5708 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_Landing_Gear_STL.stl</uri><scale>0.001 0.001093 0.001</scale></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="leg_3">
        <pose>-0.091 -0.091 -0.0025 1.5708 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_Landing_Gear_STL.stl</uri><scale>0.001 0.001093 0.001</scale></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.017 0 0 0</pose>
        <geometry><box><size>0.20 0.20 0.040</size></box></geometry>
      </collision>
      <collision name="leg_0_collision">
        <pose>0.091 -0.091 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.0144</radius><length>0.047</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="leg_1_collision">
        <pose>-0.091 0.091 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.0144</radius><length>0.047</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="leg_2_collision">
        <pose>0.091 0.091 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.0144</radius><length>0.047</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="leg_3_collision">
        <pose>-0.091 -0.091 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.0144</radius><length>0.047</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></pressure></air_pressure>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.012 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev><dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev><dynamic_bias_stddev>0.006</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- ToF inferior (VL53): un rayo hacia abajo, 0.04-3.6 m, ~30 Hz -->
      <sensor name="tof_bottom" type="gpu_lidar">
        <pose>0 0 -0.006 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>dd24/tof_bottom/scan</topic>
        <lidar>
          <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.04</min><max>3.6</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <link name="rotor_0">
      <pose>0.091 -0.091 0.003 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>2.0e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-05</iyy><iyz>0</iyz><izz>1.6e-05</izz></inertia>
      </inertial>
      <visual name="motor"><pose>0 0 0.006 0 0 0</pose><geometry><cylinder><radius>0.0135</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.75 0.15 0.10 1</ambient><diffuse>0.75 0.15 0.10 1</diffuse></material></visual>
      <visual name="prop">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_CCW_prop_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>1.0 0.92 0.0 1</ambient><diffuse>1.0 0.92 0.0 1</diffuse></material>
      </visual>
      <collision name="rotor_0_collision">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><cylinder><radius>0.063</radius><length>0.005</length></cylinder></geometry>
        <surface><contact><collide_without_contact>1</collide_without_contact></contact></surface>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_1">
      <pose>-0.091 0.091 0.003 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>2.0e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-05</iyy><iyz>0</iyz><izz>1.6e-05</izz></inertia>
      </inertial>
      <visual name="motor"><pose>0 0 0.006 0 0 0</pose><geometry><cylinder><radius>0.0135</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.75 0.15 0.10 1</ambient><diffuse>0.75 0.15 0.10 1</diffuse></material></visual>
      <visual name="prop">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_CCW_prop_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>1.0 0.92 0.0 1</ambient><diffuse>1.0 0.92 0.0 1</diffuse></material>
      </visual>
      <collision name="rotor_1_collision">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><cylinder><radius>0.063</radius><length>0.005</length></cylinder></geometry>
        <surface><contact><collide_without_contact>1</collide_without_contact></contact></surface>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_2">
      <pose>0.091 0.091 0.003 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>2.0e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-05</iyy><iyz>0</iyz><izz>1.6e-05</izz></inertia>
      </inertial>
      <visual name="motor"><pose>0 0 0.006 0 0 0</pose><geometry><cylinder><radius>0.0135</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.75 0.15 0.10 1</ambient><diffuse>0.75 0.15 0.10 1</diffuse></material></visual>
      <visual name="prop">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_CW_prop_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>1.0 0.92 0.0 1</ambient><diffuse>1.0 0.92 0.0 1</diffuse></material>
      </visual>
      <collision name="rotor_2_collision">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><cylinder><radius>0.063</radius><length>0.005</length></cylinder></geometry>
        <surface><contact><collide_without_contact>1</collide_without_contact></contact></surface>
      </collision>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_3">
      <pose>-0.091 -0.091 0.003 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>2.0e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-05</iyy><iyz>0</iyz><izz>1.6e-05</izz></inertia>
      </inertial>
      <visual name="motor"><pose>0 0 0.006 0 0 0</pose><geometry><cylinder><radius>0.0135</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.75 0.15 0.10 1</ambient><diffuse>0.75 0.15 0.10 1</diffuse></material></visual>
      <visual name="prop">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://dd24/meshes/DD24_CW_prop_STL.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>1.0 0.92 0.0 1</ambient><diffuse>1.0 0.92 0.0 1</diffuse></material>
      </visual>
      <collision name="rotor_3_collision">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><cylinder><radius>0.063</radius><length>0.005</length></cylinder></geometry>
        <surface><contact><collide_without_contact>1</collide_without_contact></contact></surface>
      </collision>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2400.0</maxRotVelocity>
      <motorConstant>2.477e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2400.0</maxRotVelocity>
      <motorConstant>2.477e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2400.0</maxRotVelocity>
      <motorConstant>2.477e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2400.0</maxRotVelocity>
      <motorConstant>2.477e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
